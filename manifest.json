{
  "manifest_version": 3,
  "name": "CountLife",
  "version": "1.0.0",
  "description": "Minimalist personal life and event deadline tracker.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_title": "CountLife"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "128": "countlife128.png"
  }
}
